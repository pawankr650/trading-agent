# ─────────────────────────────────────────────────────────────
# StockPilot secrets — copy to .env and fill in:   cp .env.example .env
# Never commit .env. Everything here is optional; add what you use.
# ─────────────────────────────────────────────────────────────

# ── Open-source LLMs (free tiers). Add at least ONE; they are tried in order. ──
# Groq        https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras    https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Hugging Face https://huggingface.co/settings/tokens  (fine-grained token with "Inference Providers" permission)
HF_TOKEN=
# OpenRouter  https://openrouter.ai/keys  (use ":free" models)
OPENROUTER_API_KEY=
# Google AI Studio (optional, not open-source) https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Local Ollama needs no key: install from https://ollama.com, then `ollama pull llama3.1`

# Optional model overrides (use when a provider retires a model — the log shows "model not found"):
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=gpt-oss-120b
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
# OLLAMA_MODEL=qwen2.5:7b

# ── Telegram (System 1 alerts + AI news digests) ──
# 1) Talk to @BotFather -> /newbot -> copy the token
# 2) Send any message to your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional second bot for the auto-trader's /status /kill /resume (avoids clashing with System 1)
TELEGRAM_TRADER_BOT_TOKEN=

# ── OpenAlgo (live data + live orders via Zerodha, Angel One, Upstox, Dhan, Fyers, …) ──
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5000

# ── Web app ──
# Required whenever the app is reachable from another machine (it can trigger scans and the kill switch).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_TOKEN=
# HOST=0.0.0.0
# PORT=8000

# ── Misc ──
LOG_LEVEL=INFO
# STOCKPILOT_CONFIG=/path/to/config.yaml
