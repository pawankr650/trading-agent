# Free LLM keys (any one is enough; tried in config.yaml order)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Hugging Face token (free) → FinBERT sentiment + zero-shot event tagging via the Inference API
# https://huggingface.co/settings/tokens   (not needed if you install transformers+torch locally)
HF_TOKEN=

# Telegram (System 1 alerts, System 2 trader bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TRADER_BOT_TOKEN=

# OpenAlgo (live data / live orders)
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5000

# 1 = offline synthetic prices + sample headlines (UI testing only)
STOCKPILOT_DEMO=0
